<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ludoBoardImage"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:layout_centerInParent="true"
        android:src="@drawable/ludo_board" /> 

    <!-- PLAYER 1 TOKENS -->

    <TextView
        android:id="@+id/p1_t1"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignLeft="@id/ludoBoardImage"
        android:layout_alignTop="@id/ludoBoardImage"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="41dp" />

    <TextView
        android:id="@+id/p1_t2"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignLeft="@id/ludoBoardImage"
        android:layout_alignTop="@id/ludoBoardImage"
        android:layout_marginLeft="89dp"
        android:layout_marginTop="40dp" />

    <!-- PLAYER 2 TOKENS -->
    <TextView
        android:id="@+id/p1_t3"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignLeft="@id/ludoBoardImage"
        android:layout_alignTop="@id/ludoBoardImage"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="90dp" />

    <TextView
        android:id="@+id/p1_t4"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignLeft="@id/ludoBoardImage"
        android:layout_alignTop="@id/ludoBoardImage"
        android:layout_marginLeft="89dp"
        android:layout_marginTop="90dp" />

    <TextView
        android:id="@+id/p2_t1"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignLeft="@id/ludoBoardImage"
        android:layout_alignBottom="@id/ludoBoardImage"
        android:layout_marginLeft="40dp"
        android:layout_marginBottom="89dp" />

    <TextView
        android:id="@+id/p2_t2"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignLeft="@id/ludoBoardImage"
        android:layout_alignBottom="@id/ludoBoardImage"
        android:layout_marginLeft="90dp"
        android:layout_marginBottom="89dp" />

    <TextView
        android:id="@+id/p2_t3"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignLeft="@id/ludoBoardImage"
        android:layout_alignBottom="@id/ludoBoardImage"
        android:layout_marginLeft="40dp"
        android:layout_marginBottom="40dp" />

    <!-- PLAYER 3 TOKENS -->

    <TextView
        android:id="@+id/p2_t4"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignLeft="@id/ludoBoardImage"
        android:layout_alignBottom="@id/ludoBoardImage"
        android:layout_marginLeft="90dp"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/p3_t1"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignTop="@id/ludoBoardImage"
        android:layout_alignRight="@id/ludoBoardImage"
        android:layout_marginTop="40dp"
        android:layout_marginRight="38dp" />

    <TextView
        android:id="@+id/p3_t2"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignTop="@id/ludoBoardImage"
        android:layout_alignRight="@id/ludoBoardImage"
        android:layout_marginTop="40dp"
        android:layout_marginRight="89dp" />

    <TextView
        android:id="@+id/p3_t3"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignTop="@id/ludoBoardImage"
        android:layout_alignRight="@id/ludoBoardImage"
        android:layout_marginTop="89dp"
        android:layout_marginRight="39dp" />

    <!-- PLAYER 4 TOKENS -->
    <TextView
        android:id="@+id/p3_t4"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignTop="@id/ludoBoardImage"
        android:layout_alignRight="@id/ludoBoardImage"
        android:layout_marginTop="90dp"
        android:layout_marginRight="89dp" />

    <TextView
        android:id="@+id/p4_t1"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignRight="@id/ludoBoardImage"
        android:layout_alignBottom="@id/ludoBoardImage"
        android:layout_marginRight="39dp"
        android:layout_marginBottom="90dp" />

    <TextView
        android:id="@+id/p4_t2"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignRight="@id/ludoBoardImage"
        android:layout_alignBottom="@id/ludoBoardImage"
        android:layout_marginRight="88dp"
        android:layout_marginBottom="88dp" />

    <TextView
        android:id="@+id/p4_t3"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignRight="@id/ludoBoardImage"
        android:layout_alignBottom="@id/ludoBoardImage"
        android:layout_marginRight="39dp"
        android:layout_marginBottom="40dp" />

    <!-- DICE BUTTONS -->
    <TextView
        android:id="@+id/p4_t4"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_alignRight="@id/ludoBoardImage"
        android:layout_alignBottom="@id/ludoBoardImage"
        android:layout_marginRight="90dp"
        android:layout_marginBottom="40dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDiceGreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="60dp"
        android:background="#00000000"
        android:text="🎲"
        android:textSize="70sp"
        android:textColor="#85FF9D" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDiceYellow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="60dp"
        android:layout_marginRight="60dp"
        android:background="#00000000"
        android:text="🎲"
        android:textSize="70sp"
        android:textColor="#F9F871" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDiceRed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_marginBottom="60dp"
        android:layout_marginLeft="60dp"
        android:background="#00000000"
        android:text="🎲"
        android:textSize="70sp"
        android:textColor="#FF6B6B" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDiceBlue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="60dp"
        android:layout_marginRight="60dp"
        android:background="#00000000"
        android:text="🎲"
        android:textSize="70sp"
        android:textColor="#82C3FF" />

    <!-- TURN INDICATOR TEXT -->
    <TextView
        android:id="@+id/tvTurnIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ludoBoardImage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="Player's Turn!"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

</RelativeLayout>